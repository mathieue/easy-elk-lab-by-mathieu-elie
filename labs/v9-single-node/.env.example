# Template of the lab settings. `./lab.sh start` (or `./lab.sh init`) copies it to
# .env and fills in random passwords. To do it by hand: copy to .env and fill them in.

# Elastic Stack version (Elasticsearch and Kibana always use the same one)
STACK_VERSION=9.5.5

CLUSTER_NAME=easy-elk-lab

# "basic" (free, never expires) or "trial" (all features, 30 days)
LICENSE=basic

# Password of the "elastic" superuser (the one you log in with)
ELASTIC_PASSWORD=
# Password of the internal "kibana_system" user
KIBANA_PASSWORD=
# At least 32 characters
KIBANA_ENCRYPTION_KEY=

# Ports published on the host
ES_PORT=9200
KIBANA_PORT=5601

# Memory: keep the container limit at about twice the heap
ES_HEAP=2g
ES_MEM_LIMIT=4g
KIBANA_HEAP_MB=1024
KIBANA_MEM_LIMIT=2g
# Fleet Server, only when started with `./lab.sh fleet start`
FLEET_MEM_LIMIT=1g
# Each bare server of `./lab.sh agent` (web-04), only when created
AGENT_MEM_LIMIT=1g

# Test data generator, used by `./lab.sh data load` (not loaded at start).
# `./lab.sh data load --days N --datasets a,b` overrides the two settings below once.
# Datasets to generate (comma separated). Available: apache, firewall, metrics, postgresql
DATAGEN_DATASETS=apache,firewall,metrics,postgresql
# Days of history loaded at first start (30 for ML or week-over-week exercises,
# then ./lab.sh data reset — or add the older days with: ./lab.sh data backfill now-30d now-7d)
DATAGEN_HISTORY_DAYS=7
# Average events per second of normal traffic, per dataset (more during the day,
# less at night). Incidents keep the same intensity whatever the rate.
# 0.1 = light (default); 1 = dense, about 10 times more data (big machines only)
DATAGEN_RATE=0.1
# Same seed = same data for everyone
DATAGEN_SEED=easy-elk-lab
# UTC offset (hours) used for the day/night traffic pattern
DATAGEN_UTC_OFFSET=1
# Seconds between two host metrics reports (metrics dataset, not changed by DATAGEN_RATE)
DATAGEN_METRICS_INTERVAL=60
# Hours of history in the Apache access log of the agent servers (web-04), written
# when the server is created (they also use DATAGEN_SEED, DATAGEN_RATE, DATAGEN_UTC_OFFSET)
DATAGEN_FILE_HISTORY_HOURS=24
